# ==============================================================================
# Autonomous Market & Financial Research Dashboard - Environment Variables
# ==============================================================================
# You can run this entire project 100% FREE without entering a credit card!
# Copy this file to `backend/.env`:
#   cp backend/.env.example backend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 100% FREE LLM OPTIONS (Pick whichever you prefer!)
# ------------------------------------------------------------------------------

# OPTION A: Google Gemini Free Tier (RECOMMENDED - Easiest & Fast)
# Free 15 requests/minute, 1,500 requests/day at zero cost.
# Get your free key in 30 seconds (no credit card needed): https://aistudio.google.com/
GEMINI_API_KEY=AQ.Ab8RN6K5KsGEwfJ9xCP1-nNEE6Jy9QnswsKfFL1BXaMQYc6ckg
DEFAULT_LLM_MODEL=gemini-3.5-flash-lite

# OPTION B: Groq Cloud Free Tier (Extremely Fast Llama 3.3 70B & Llama 3.1 8B)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OPTION C: 100% Local & Private with Ollama (Runs on your Mac, Zero API Keys)
# Run in terminal: `brew install ollama && ollama run llama3.2`
# Then set:
USE_LOCAL_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# OPTION D: OpenRouter Free Models (e.g. meta-llama/llama-3.1-8b-instruct:free)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# 2. COMMERCIAL LLMs (Optional Paid Alternatives)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 3. 100% FREE VECTOR DATABASE (Qdrant Embedded)
# ------------------------------------------------------------------------------
# ":memory:" runs an embedded Qdrant instance inside RAM with 0 Docker & 0 cost!
QDRANT_LOCATION=:memory:
QDRANT_COLLECTION_NAME=sec_filings

# ------------------------------------------------------------------------------
# 4. 100% FREE FINANCIAL & SEC DATA TOOLS
# ------------------------------------------------------------------------------
# yfinance is already bundled for 100% free live stock prices, P/E ratios & margins.
# SEC EDGAR is public US Government domain data requiring only your user-agent:
SEC_EDGAR_USER_AGENT=FinancialResearchAgent Admin@example.com

# (Optional paid keys - not required):
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=

# ------------------------------------------------------------------------------
# 5. SERVER SETTINGS
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LANGCHAIN_TRACING_V2=false
